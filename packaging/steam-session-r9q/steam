#!/usr/bin/bash
# `steam` on the Galaxy S21 FE: Valve's native arm64 client (the linuxarm64
# build of the Steam Frame), installed per user in ~/.local/share/Steam.
# Arch has no arm64 steam package; gamescope-session-steam and Steam's own
# shortcuts and steam:// handlers run `steam`. Based on ArmadaOS' launch-steam.
set -euo pipefail

steam_root="${STEAM_ROOT:-${HOME}/.local/share/Steam}"
arm_dir="${steam_root}/steamrtarm64"

if [[ ! -x "${arm_dir}/steam" ]]; then
	echo "steam: installing the arm64 Steam client (first start)..." >&2
	/usr/lib/r9q/r9q-steam-bootstrap || {
		echo "steam: the arm64 client is not installed and the bootstrap failed" >&2
		exit 127
	}
fi

# Libraries the client loads from the host that Arch does not ship (ArmadaOS
# gets them from Fedora): take them from Valve's own arm64 runtime. GTK 2 is
# needed by steamui.so (Arch moved gtk2 to the AUR). Refreshed at every start
# because Steam updates its runtime (new platform directory).
shim="${steam_root}/lib/aarch64-linux-gnu"
platform=$(ls -d "${steam_root}"/steam-runtime-steamrt-arm64/steamrt3c_platform_*/files/lib/aarch64-linux-gnu 2>/dev/null | sort | tail -n1)
if [[ -n "${platform}" ]]; then
	mkdir -p "${shim}"
	for lib in libibus-1.0.so.5 libgtk-x11-2.0.so.0 libgdk-x11-2.0.so.0; do
		target=$(ls "${platform}/${lib}".* 2>/dev/null | sort | tail -n1)
		[[ -n "${target}" ]] && ln -sfn "${target}" "${shim}/${lib}"
	done
fi

# the arm64 client always runs in Steam Deck mode (gamescope passes it too)
args=("$@")
[[ " $* " == *" -steamdeck "* ]] || args=(-steamdeck "${args[@]}")

ld="${arm_dir}"
[[ -d "${steam_root}/lib/aarch64-linux-gnu" ]] && ld="${ld}:${steam_root}/lib/aarch64-linux-gnu"
export LD_LIBRARY_PATH="${ld}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
[[ -d "${steam_root}/steam-runtime-steamrt-arm64/bin" ]] &&
	export PATH="${steam_root}/steam-runtime-steamrt-arm64/bin:${PATH}"
export FUSERMOUNT_PROG=/run/host/usr/bin/fusermount3
# Steam restores these for compatibility tools, which otherwise start with no PATH
export SYSTEM_PATH="${PATH}"
export SYSTEM_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"

cd "${arm_dir}"
exec "${arm_dir}/steam" "${args[@]}"
