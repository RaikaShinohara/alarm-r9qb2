#!/usr/bin/bash
# Seed Valve's arm64 Steam client in ~/.local/share/Steam, as ArmadaOS'
# packages/steam-bootstrap does at build time: the bins_linuxarm64 package
# of the steamdeck_stable linuxarm64 client manifest (checked against the
# manifest's SHA-256) and the steamrt3c arm64 runtime (pinned version and
# SHA-256, ArmadaOS' BASE.env). On its first start Steam downloads and
# installs the rest of its packages itself.
# Usage: r9q-steam-bootstrap   (as the user; needs network)
set -euo pipefail

CDN=https://client-update.steamstatic.com
CHANNEL=steamdeck_stable
MANIFEST=steam_client_${CHANNEL}_linuxarm64
RUNTIME_VERSION=3c.0.20260729.253765
RUNTIME_SHA256=d0e21db9538bcbdfa51b46f0acbba8a3dcbd6e5f345ae410a6b89d9b90b7d09e
RUNTIME_URL=https://repo.steampowered.com/steamrt3c/images/${RUNTIME_VERSION}/steam-runtime-steamrt-arm64.tar.xz

steam="${HOME:?}/.local/share/Steam"
dot="${HOME}/.steam"
pkg="${steam}/package"

fetch() { # url file sha256
	curl --retry 5 -fLsS -o "$2.partial" "$1"
	echo "$3  $2.partial" | sha256sum -c --quiet - || { rm -f "$2.partial"; echo "SHA-256 mismatch: $1" >&2; return 1; }
	mv "$2.partial" "$2"
}

mkdir -p "${pkg}" "${dot}"
echo "${CHANNEL}" > "${pkg}/beta"
ln -sfn ../.local/share/Steam "${dot}/steam"
ln -sfn ../.local/share/Steam "${dot}/root"
ln -sfn ../.local/share/Steam/linux32 "${dot}/sdk32"
ln -sfn ../.local/share/Steam/linux64 "${dot}/sdk64"
ln -sfn ../.local/share/Steam/linuxarm64 "${dot}/sdkarm64"
ln -sfn ../.local/share/Steam/ubuntu12_32 "${dot}/bin32"
ln -sfn ../.local/share/Steam/ubuntu12_64 "${dot}/bin64"

# 1. client seed: bins_linuxarm64 from the current manifest
curl --retry 5 -fLsS -o "${pkg}/${MANIFEST}.manifest" "${CDN}/${MANIFEST}"
version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*"\([0-9]*\)".*/\1/p' "${pkg}/${MANIFEST}.manifest" | head -n1)
read -r seed seed_sha < <(awk '
	$1 == "\"bins_linuxarm64_linuxarm64\"" { f = 1 }
	f && $1 == "\"file\"" { gsub(/"/, "", $2); file = $2 }
	f && $1 == "\"sha2\"" { gsub(/"/, "", $2); sha = $2 }
	f && $1 == "}" { print file, sha; exit }' "${pkg}/${MANIFEST}.manifest")
[[ "${seed}" =~ ^bins_linuxarm64_linuxarm64\.zip\.[A-Za-z0-9]+$ && "${seed_sha}" =~ ^[0-9a-f]{64}$ ]] ||
	{ echo "cannot find the arm64 seed package in the manifest" >&2; exit 1; }
echo "Steam client ${version} (${CHANNEL}): ${seed}" >&2
fetch "${CDN}/${seed}" "${pkg}/${seed}" "${seed_sha}"
bsdtar -xf "${pkg}/${seed}" -C "${steam}"
# the zip also has Windows-style directory records ("steamrtarm64\libs\"):
# bsdtar keeps them as empty directories with a backslash in the name
find "${steam}" -maxdepth 2 -type d -name '*\\*' -empty -delete
# zip drops the exec bits: restore them on ELF files and scripts
bsdtar -tf "${pkg}/${seed}" | while IFS= read -r f; do
	p="${steam}/${f}"
	[[ -f "${p}" ]] || continue
	case "$(head -c4 "${p}" | od -An -tx1 | tr -d ' \n')" in
	7f454c46 | 2321*) chmod +x "${p}" ;;
	esac
done

# 2. arm64 runtime (steamrt3c)
rt="${pkg}/steam-runtime-steamrt-arm64-${RUNTIME_VERSION}.tar.xz"
fetch "${RUNTIME_URL}" "${rt}" "${RUNTIME_SHA256}"
tar -xJf "${rt}" -C "${steam}"
rm -f "${rt}"
ibus=$(find "${steam}/steam-runtime-steamrt-arm64" -path '*/files/lib/aarch64-linux-gnu/libibus-1.0.so.5.*' -type f | sort | tail -n1)
if [[ -n "${ibus}" ]]; then
	mkdir -p "${steam}/lib/aarch64-linux-gnu"
	ln -sfn "../../${ibus#"${steam}/"}" "${steam}/lib/aarch64-linux-gnu/libibus-1.0.so.5"
fi

[[ -x "${steam}/steamrtarm64/steam" ]] || { echo "the seed did not install steamrtarm64/steam" >&2; exit 1; }
echo "arm64 Steam client seeded in ${steam}; Steam finishes installing itself on its first start" >&2
