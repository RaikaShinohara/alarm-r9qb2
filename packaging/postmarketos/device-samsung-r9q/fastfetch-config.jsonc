// System-wide fastfetch defaults for the Samsung Galaxy S21 FE (r9q).
// fastfetch names Qualcomm "sm" SoCs after their device tree compatible
// ("sm8350"), so spell out the marketing name. A user config in
// ~/.config/fastfetch/ takes precedence over this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    {
      "type": "cpu",
      "format": "Qualcomm Snapdragon 888 ({core-types}) @ {freq-max}"
    },
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
