# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
#
# Bluetooth (QCA6490 on UART18) runs on the controller's ROM firmware: there
# are no files in /usr/lib/firmware/qca on purpose. With a patch (Samsung's
# or linux-firmware's hpbtfw21.tlv), LE connections fail with 0x3e, so do
# not install linux-firmware-qca.
pkgname=device-samsung-r9q
pkgdesc="Samsung Galaxy S21 FE 5G (Snapdragon)"
pkgver=1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	firmware-qcom-adreno-a660
	firmware-samsung-r9q-adreno
	firmware-samsung-r9q-adsp
	firmware-samsung-r9q-audio
	firmware-samsung-r9q-cdsp
	firmware-samsung-r9q-hexagonfs
	firmware-samsung-r9q-modem
	firmware-samsung-r9q-slpi
	firmware-samsung-r9q-wifi
	hexagonrpcd
	iio-sensor-proxy
	libssc
	rmtfs
	soc-qcom
	soc-qcom-modem
	linux-samsung-r9q
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	81-libssc-samsung-r9q.rules
	bootmac-bluetooth-samsung-r9q.conf
	deviceinfo
	fastfetch-config.jsonc
	iio-sensor-proxy-samsung-r9q.conf
	kwinrc
	modprobe-samsung-r9q.conf
	msm-modem-uim-selection-samsung-r9q.conf
	plasmaparc
	rmtfs-no-modem-autostart.conf
	ucm-HiFi.conf
	ucm-Samsung-Galaxy-S21-FE.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/modprobe-samsung-r9q.conf \
		"$pkgdir"/usr/lib/modprobe.d/samsung-r9q.conf
	install -Dm644 "$srcdir"/fastfetch-config.jsonc \
		"$pkgdir"/etc/xdg/fastfetch/config.jsonc
	install -Dm644 "$srcdir"/81-libssc-samsung-r9q.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-samsung-r9q.rules
	install -Dm644 "$srcdir"/rmtfs-no-modem-autostart.conf \
		"$pkgdir"/usr/lib/systemd/system/rmtfs.service.d/10-samsung-r9q.conf
	install -Dm644 "$srcdir"/msm-modem-uim-selection-samsung-r9q.conf \
		"$pkgdir"/usr/lib/systemd/system/msm-modem-uim-selection.service.d/10-samsung-r9q.conf
	install -Dm644 "$srcdir"/iio-sensor-proxy-samsung-r9q.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-samsung-r9q.conf
	install -Dm644 "$srcdir"/bootmac-bluetooth-samsung-r9q.conf \
		"$pkgdir"/usr/lib/systemd/system/bootmac@bluetooth.service.d/10-samsung-r9q.conf

	# Speakers: sound card "Samsung-Galaxy-S21-FE" (driver sm8350)
	install -Dm644 "$srcdir"/ucm-Samsung-Galaxy-S21-FE.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8350/Samsung-Galaxy-S21-FE.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Samsung/r9q/HiFi.conf

	install -Dm644 "$srcdir"/kwinrc "$pkgdir"/etc/xdg/kwinrc

	# The ABL forces console=null, so systemd-firstboot always fails with
	# 208/STDIN ("degraded" system); pmbootstrap already sets locale/user.
	mkdir -p "$pkgdir"/etc/systemd/system
	ln -s /dev/null "$pkgdir"/etc/systemd/system/systemd-firstboot.service
	install -Dm644 "$srcdir"/plasmaparc "$pkgdir"/etc/xdg/plasmaparc
}

