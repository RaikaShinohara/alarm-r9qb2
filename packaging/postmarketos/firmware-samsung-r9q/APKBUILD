# Maintainer: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
#
# Firmware from the stock SM-G990B2 partitions (vendor, NON-HLOS, modem).
#
# Wi-Fi (/vendor/firmware/qca6490): linux-firmware's WCN6855 WLAN.HSP.1.1
# crashes (MHI RDDM) as soon as it gets Samsung's ELF board file, so ship
# Samsung's WLAN.HSP.2.0 firmware. The kernel DT sets firmware-name =
# "samsung-r9q", so ath11k loads amss/m3/regdb from
# ath11k/WCN6855/hw2.1/samsung-r9q/. Board files are always read from the
# hw2.1 directory itself; do not install linux-firmware-ath11k next to this,
# its board-2.bin has a generic entry for this module's PCI IDs
# (17cb:1103 17cb:0108) that would win.
#
# Adreno 660 zap shader and the ADSP/CDSP/SLPI/modem images are signed for
# this device; they were merged from the stock .mdt + .bNN files with
# scripts/squash-mdt.py. a660_sqe.fw / a660_gmu.bin come from
# firmware-qcom-adreno-a660. modem_pr/ holds the carrier configs (mcfg)
# that tqftpserv serves to the modem.
#
# hexagonfs: the files hexagonrpcd serves to the sensor DSP (SLPI), laid out
# as hexagonrpcd expects under /usr/share/qcom/sm8350/Samsung/r9q (its default
# guess from the DT model/compatible): dsp/sdsp from the dsp partition,
# sensors/config + sns_reg.conf from /vendor/etc/sensors, sensors/registry from
# persist (holds this unit's factory calibration) and socinfo/ with the stock
# /sys/devices/soc0 values (MTP, subtype 0, soc_id 415, rev 2.1).
# sensors/sns_reg_version (+ sensors_list.txt, sensors_settings) also come from
# persist: without it the SSC thinks the registry is stale, tries to rebuild it
# (endless temp.json writes, denied by hexagonrpcd) and never comes up; the
# patched hexagonrpcd (device/testing/hexagonrpcd) serves it. sensors/config is
# left empty on purpose: the persist registry is complete, nothing to rebuild.
# socinfo/ssc_hw_rev = Samsung SSC board revision (14).
#
# audio: Samsung's speaker protection (CSPL 20.1.35) for the two CS35L41
# amplifiers, from /vendor/firmware/cs35l40-{rcv,bot}-dsp1-spk-prot.*: "rcv"
# is the top speaker (earpiece), "bot" the bottom one. Both use the same
# .wmfw, only the tuning .bin differs. The cs35l41 driver asks for
# cirrus/cs35l41-dsp1-spk-prot-<cirrus,subsystem-id>-<sound-name-prefix>,
# i.e. samsung-r9q-top / samsung-r9q-bottom. The factory calibration
# (impedance) is not a file: it is in the DT (cirrus,calibration).
pkgname=firmware-samsung-r9q
pkgver=1
pkgrel=5
pkgdesc="Firmware for Samsung Galaxy S21 FE 5G (Snapdragon)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
subpackages="
	$pkgname-adreno:adreno
	$pkgname-adsp:adsp
	$pkgname-audio:audio
	$pkgname-cdsp:cdsp
	$pkgname-hexagonfs:hexagonfs
	$pkgname-modem:modem
	$pkgname-slpi:slpi
	$pkgname-wifi:wifi
"
source="
	a660_zap.mbn
	adsp.mbn
	adspr.jsn
	adspua.jsn
	amss20.bin
	bdwlan.elf
	cdsp.mbn
	cdspr.jsn
	cs35l41-spk-prot.wmfw
	cs35l41-spk-prot-bottom.bin
	cs35l41-spk-prot-top.bin
	hexagonfs.tar.gz
	m3.bin
	modem.mbn
	modem_pr.tar.gz
	modemr.jsn
	regdb.bin
	slpi.mbn
	slpir.jsn
	slpius.jsn
"
_fwdir=/usr/lib/firmware/qcom/sm8350/samsung/r9q

package() {
	mkdir -p "$pkgdir"
}

adreno() {
	pkgdesc="Samsung Galaxy S21 FE Adreno 660 zap shader"

	install -Dm644 "$srcdir"/a660_zap.mbn -t "$subpkgdir/$_fwdir"/
}

adsp() {
	pkgdesc="Samsung Galaxy S21 FE audio DSP firmware"

	install -Dm644 "$srcdir"/adsp.mbn "$srcdir"/adspr.jsn \
		"$srcdir"/adspua.jsn -t "$subpkgdir/$_fwdir"/
}

audio() {
	pkgdesc="Samsung Galaxy S21 FE speaker protection firmware (CS35L41)"
	local _dir="$subpkgdir"/usr/lib/firmware/cirrus
	local _fw=cs35l41-dsp1-spk-prot-samsung-r9q
	local _spk

	for _spk in top bottom; do
		install -Dm644 "$srcdir"/cs35l41-spk-prot.wmfw "$_dir/$_fw-$_spk.wmfw"
		install -Dm644 "$srcdir"/cs35l41-spk-prot-$_spk.bin "$_dir/$_fw-$_spk.bin"
	done
}

cdsp() {
	pkgdesc="Samsung Galaxy S21 FE compute DSP firmware"

	install -Dm644 "$srcdir"/cdsp.mbn "$srcdir"/cdspr.jsn \
		-t "$subpkgdir/$_fwdir"/
}

hexagonfs() {
	pkgdesc="Samsung Galaxy S21 FE sensor DSP files for hexagonrpcd"
	local _dir="$subpkgdir"/usr/share/qcom/sm8350/Samsung/r9q

	mkdir -p "$_dir"
	cp -r "$srcdir"/hexagonfs/. "$_dir"/
	find "$_dir" -type d -exec chmod 0755 {} \;
	find "$_dir" -type f -exec chmod 0644 {} \;
}

modem() {
	pkgdesc="Samsung Galaxy S21 FE modem firmware"

	install -Dm644 "$srcdir"/modem.mbn "$srcdir"/modemr.jsn \
		-t "$subpkgdir/$_fwdir"/
	cp -r "$srcdir"/modem_pr "$subpkgdir/$_fwdir"/
	find "$subpkgdir/$_fwdir"/modem_pr -type d -exec chmod 0755 {} \;
	find "$subpkgdir/$_fwdir"/modem_pr -type f -exec chmod 0644 {} \;
}

slpi() {
	pkgdesc="Samsung Galaxy S21 FE sensor DSP firmware"

	install -Dm644 "$srcdir"/slpi.mbn "$srcdir"/slpir.jsn \
		"$srcdir"/slpius.jsn -t "$subpkgdir/$_fwdir"/
}

wifi() {
	pkgdesc="Samsung Galaxy S21 FE Wi-Fi firmware (QCA6490, WLAN.HSP.2.0)"
	local _dir="$subpkgdir"/usr/lib/firmware/ath11k/WCN6855/hw2.1

	install -Dm644 "$srcdir"/amss20.bin "$_dir"/samsung-r9q/amss.bin
	install -Dm644 "$srcdir"/m3.bin "$_dir"/samsung-r9q/m3.bin
	install -Dm644 "$srcdir"/regdb.bin "$_dir"/samsung-r9q/regdb.bin
	install -Dm644 "$srcdir"/bdwlan.elf "$_dir"/board.bin
}

