# Maintainer: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
# Kernel for the Samsung Galaxy S21 FE 5G (Snapdragon 888 / SM8350)
# Based on linux-postmarketos-stable + one device tree.
# 0001/0002: persistent console in Samsung's sec_log_buf (TWRP /proc/last_kmsg)
# and a 'probing X with driver Y' trace when booted with initcall_debug.
# 0003: route the MAX77705 USB switch to the SoC at boot (no replug needed).
# 0004: accept the MAX77705 PASS2 silicon used in the S21 FE (charger/fuel gauge).
# 0005: DRM panel driver for the Samsung EA8082 AMB641ZR01 (DSI cmd mode + DSC,
#       60/120 Hz via panel_samsung_ea8082.refresh_rate).
# 0006: Synaptics TouchComm I2C touchscreen driver + binding (S3908), v2 from
#       linux-input (Vsevolod Nevorotov, 2026-09-10, not merged yet).
# 0007: make its reset GPIO optional (not wired on this board).
# 0008: qcom gpi: retire the TX descriptor of I2C reads (TX ring filled up and
#       every touch read failed with "not enough space in ring").
# 0009: decode Samsung's 0xc1 coordinate events (the S3908 firmware of this
#       phone never sends standard TouchComm touch reports).
# 0010-0019: MAX77705 charger OTG regulator and Type-C/PD driver, from the
#       Galaxy Tab S8+ port (aaronsb/sm-x800-linux, ADR-003): OTG host with
#       VBUS, gadget mode via role switch, PD sink at most 9 V / 15 W.
# 0020: DisplayPort alternate mode on the MAX77705 (HDMI/DP adapters).
# 0021: gcc-sm8350 GP clocks with the general purpose ops (any rate and duty),
#       for the vibration motor PWM (clk-pwm on GCC GP2).
# 0022: max77693-haptic: enable the motor bias on the MAX77705 as well.
# 0023: sm8250 sound card: samsung,r9q-sndcard, two CS35L41 on primary MI2S
#       (SCLK as their PLL reference, one I2S slot each).
# 0024: cs35l41: interrupt the DSP for CSPL mailbox commands (Samsung's
#       speaker protection firmware 20.1.35 needs it, and up to 15 ms).
# 0025: cs35l41: factory speaker calibration (cirrus,calibration) and CSPL
#       resume after the amplifier's global enable.
# 0026: build the MAX77705 Type-C driver as max77705_typec: its old module
#       name clashed with the (built-in) MAX77705 MFD core, so udev's modprobe
#       never loaded it and the display waited forever for DisplayPort.
pkgname=linux-samsung-r9q
pkgver=7.2.13
pkgrel=10
_kver=${pkgver%.*}
pkgdesc="Samsung Galaxy S21 FE 5G mainline kernel"
arch="aarch64"
_carch="arm64"
_flavor="samsung-r9q"
url="https://kernel.org"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
"
makedepends="
	bash
	bison
	clang
	clang-libclang
	diffutils
	elfutils-dev
	findutils
	flex
	grep
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	rust
	rust-bindgen
	rust-src
	rustfmt
	sed
	zstd
"
source="
	patch-$pkgver.patch.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/patch-$pkgver.xz
	linux-$_kver.tar.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$_kver.tar.xz
	0001-soc-qcom-samsung-sec-log-console.patch
	0002-probe-trace-and-sec-log-kconfig.patch
	0003-misc-max77705-usb-switch.patch
	0004-mfd-max77705-accept-pass2.patch
	0005-drm-panel-add-samsung-ea8082.patch
	0006-input-add-synaptics-touchcomm-i2c.patch
	0007-input-synaptics-tcm-i2c-optional-reset.patch
	0008-dmaengine-qcom-gpi-retire-linked-tx-descriptors.patch
	0009-input-synaptics-tcm-i2c-samsung-coordinate-events.patch
	0010-max77705-charger-otg-regulator.patch
	0011-max77705-charger-battery-info.patch
	0012-max77705-charger-otg-shutdown.patch
	0013-max77705-charger-aicl-bounded.patch
	0014-max77705-charger-aicl-notify.patch
	0015-max77705-charger-review-fixes.patch
	0016-max77705-typec.patch
	0017-max77705-typec-source-attach.patch
	0018-max77705-typec-prefer-voltage.patch
	0019-max77705-typec-review-fixes.patch
	0020-max77705-typec-displayport-altmode.patch
	0021-clk-qcom-gcc-sm8350-gp-clock-ops.patch
	0022-input-max77693-haptic-max77705-bias.patch
	0023-asoc-qcom-sm8250-samsung-r9q-cs35l41.patch
	0024-asoc-cs35l41-cspl-mailbox-irq.patch
	0025-asoc-cs35l41-calibration-first-resume.patch
	0026-usb-typec-max77705-module-name.patch
	sm8350-samsung-r9q.dts
	config-$_flavor.aarch64
"
builddir="$srcdir/linux-$_kver"

prepare() {
	default_prepare
	cp "$srcdir"/sm8350-samsung-r9q.dts arch/arm64/boot/dts/qcom/
	echo 'dtb-$(CONFIG_ARCH_QCOM) += sm8350-samsung-r9q.dtb' \
		>> arch/arm64/boot/dts/qcom/Makefile
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

