# Maintainer: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
# Arch's mangohud PKGBUILD (Campbell Jones, George Rawlinson; x86_64 only)
# built for aarch64: Arch Linux ARM does not ship it. Steam's performance
# overlay in game mode is MangoHud's mangoapp (STEAM_USE_MANGOAPP=1 in
# gamescope-session-steam). Changes: aarch64, no XNVCtrl (NVIDIA only), no
# tests (cmocka), matplotlib/numpy optional (only mangoplot uses them), and
# 0001: GPU load on msm (fdinfo says "msm", MangoHud expected "msm_dpu").
_pkgname=MangoHud
pkgname=mangohud
pkgver=0.8.4
pkgrel=2
pkgdesc="A Vulkan overlay layer for monitoring FPS, temperatures, CPU/GPU load and more."
arch=('aarch64')
url="https://github.com/flightlessmango/MangoHud"
license=('MIT')
# build-packages.sh only installs makedepends (makepkg -d): list the libraries it
# compiles against here too
makedepends=('git' 'glslang' 'libxrandr' 'meson' 'python-mako' 'vulkan-headers'
	'dbus' 'fmt' 'glfw' 'libglvnd' 'libx11' 'libxkbcommon' 'vulkan-icd-loader' 'wayland')
depends=('dbus' 'fmt' 'glfw' 'hicolor-icon-theme' 'libglvnd' 'libx11' 'libxkbcommon'
	'python' 'vulkan-icd-loader' 'wayland')
optdepends=('gamescope: Use MangoApp as an overlay within gamescope'
	'python-matplotlib: mangoplot' 'python-numpy: mangoplot')
conflicts=('mangoapp')
replaces=('mangoapp')
source=("$pkgname-$pkgver.tar.xz::https://github.com/flightlessmango/MangoHud/releases/download/v$pkgver/$_pkgname-v$pkgver-Source.tar.xz"
	0001-fdinfo-match-msm-driver-name.patch)
b2sums=('06bdfcd26e14ff544e4dea4e39b8f7da6119d87fc7e14f381cf8c47bba69508a4768b8584600424adb8ca2a2f6f4c2d84d63683addeb83bd0dd9a1e055febdb8'
	'SKIP')

prepare() {
	cd "$_pkgname-v$pkgver"
	patch -Np1 -i "$srcdir"/0001-fdinfo-match-msm-driver-name.patch
}

build() {
	arch-meson "$_pkgname-v$pkgver" build \
		-Dmangoapp=true \
		-Dmangohudctl=true \
		-Dwith_xnvctrl=disabled \
		-Dtests=disabled
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm 0644 "$srcdir/$_pkgname-v$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
	rm --force "$pkgdir/usr/lib/libimgui.a"
}
