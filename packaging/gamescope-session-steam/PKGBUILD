# Maintainer: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
# Steam Big Picture client for gamescope-session-plus (OpenGamingCollective,
# formerly ChimeraOS). Same commit as Terra/ArmadaOS use. It runs `steam`:
# on this phone that is the arm64 client launcher from steam-session-r9q
# (Arch has no arm64 steam package), so it does not depend on 'steam'.
pkgname=gamescope-session-steam
_commit=82c45fc112775e3fa927d5c326c39b21f1761cc1
pkgver=0.20260919
pkgrel=1
pkgdesc="Steam Big Picture session for gamescope-session-plus"
arch=('any')
url="https://github.com/OpenGamingCollective/gamescope-session-steam"
license=('MIT')
depends=('gamescope-session-plus')
source=("gamescope-session-steam-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('5129c0269158dc7714ea90ba6f525d30c32c668e5fb7741e1e02da9ed7c53b46')

package() {
	cd "gamescope-session-steam-$_commit"
	install -Dm755 usr/bin/steam-http-loader usr/bin/steamos-select-branch \
		usr/bin/steamos-session-select usr/bin/steamos-update -t "$pkgdir"/usr/bin/
	install -Dm755 usr/bin/steamos-polkit-helpers/steamos-update \
		usr/bin/steamos-polkit-helpers/steamos-select-branch \
		-t "$pkgdir"/usr/bin/steamos-polkit-helpers/
	install -Dm644 usr/share/applications/steam_http_loader.desktop \
		usr/share/applications/gamescope-mimeapps.list -t "$pkgdir"/usr/share/applications/
	install -Dm755 usr/share/gamescope-session-plus/sessions.d/steam \
		-t "$pkgdir"/usr/share/gamescope-session-plus/sessions.d/
	install -Dm644 usr/share/polkit-1/actions/org.chimeraos.update.policy \
		-t "$pkgdir"/usr/share/polkit-1/actions/
	install -Dm644 usr/share/wayland-sessions/gamescope-session-steam.desktop \
		-t "$pkgdir"/usr/share/wayland-sessions/
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
