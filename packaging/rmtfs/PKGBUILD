# Maintainer: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
# Qualcomm remote filesystem service: serves the modem EFS partitions.
# On the S21 FE it must stay read-only (-r: EFS holds the IMEI and RF
# calibration) and must not boot the modem (no -s), see docs/porting-log.md.
pkgname=rmtfs
pkgver=1.3
pkgrel=1
pkgdesc="Qualcomm remote filesystem service"
arch=('aarch64')
url="https://github.com/linux-msm/rmtfs"
license=('BSD-3-Clause')
depends=('qrtr' 'systemd-libs')
makedepends=('linux-api-headers')
source=("$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/rmtfs/archive/refs/tags/v$pkgver.tar.gz"
	rmtfs.service
	80-rmtfs.rules)
sha256sums=('SKIP' 'SKIP' 'SKIP')

build() {
	make -C "$pkgname-$pkgver" prefix=/usr
}

package() {
	install -Dm755 "$pkgname-$pkgver"/rmtfs -t "$pkgdir"/usr/bin/
	install -Dm644 rmtfs.service -t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 80-rmtfs.rules -t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm644 "$pkgname-$pkgver"/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/ 2>/dev/null || true
}
