From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Subject: [PATCH] ASoC: cs35l41: interrupt the DSP for CSPL mailbox commands

Samsung's CSPL protection firmware (20.1.35, Galaxy S21 FE) acts on a
mailbox command only when the VIRT1 mailbox interrupts the DSP, and
answers after a few ms: RESUME was reported as failed (status PAUSED) and
PAUSE as RUNNING. Clear the sticky bits, unmask the DSP interrupt around
the command and poll up to 15 ms, as the Cirrus vendor driver does.

---
--- a/sound/soc/codecs/cs35l41-lib.c
+++ b/sound/soc/codecs/cs35l41-lib.c
@@ -1452,22 +1452,43 @@
 	}
 }
 
+/* VIRT1 mailbox: host to DSP; VIRT2: DSP to host (IRQx_STATUS2/MASK2 bits) */
+#define CS35L41_CSPL_MBOX_DSP_IRQ	BIT(20)
+#define CS35L41_CSPL_MBOX_HOST_IRQ	BIT(21)
+#define CS35L41_CSPL_MBOX_POLLS		15
+
 int cs35l41_set_cspl_mbox_cmd(struct device *dev, struct regmap *regmap,
 			      enum cs35l41_cspl_mbox_cmd cmd)
 {
 	unsigned int sts = 0, i;
+	bool irq = cmd != CSPL_MBOX_CMD_OUT_OF_HIBERNATE;
 	int ret;
 
+	/*
+	 * Older CSPL firmware (Samsung's 20.1.35) only takes a command when the
+	 * mailbox interrupts the DSP, and answers within ~15 ms: clear both
+	 * sticky mailbox bits and unmask the DSP's VIRT1 interrupt around the
+	 * command, as Cirrus' vendor driver does. Not while hibernating, when
+	 * the registers are not reachable.
+	 */
+	if (irq) {
+		regmap_write(regmap, CS35L41_IRQ2_STATUS2, CS35L41_CSPL_MBOX_DSP_IRQ);
+		regmap_write(regmap, CS35L41_IRQ1_STATUS2, CS35L41_CSPL_MBOX_HOST_IRQ);
+		regmap_update_bits(regmap, CS35L41_IRQ2_MASK2,
+				   CS35L41_CSPL_MBOX_DSP_IRQ, 0);
+	}
+
 	// Set mailbox cmd
 	ret = regmap_write(regmap, CS35L41_DSP_VIRT1_MBOX_1, cmd);
 	if (ret < 0) {
 		if (cmd != CSPL_MBOX_CMD_OUT_OF_HIBERNATE)
 			dev_err(dev, "Failed to write MBOX: %d\n", ret);
-		return ret;
+		goto out;
 	}
 
 	// Read mailbox status and verify it is appropriate for the given cmd
-	for (i = 0; i < 5; i++) {
+	ret = -ENOMSG;
+	for (i = 0; i < CS35L41_CSPL_MBOX_POLLS; i++) {
 		usleep_range(1000, 1100);
 
 		ret = regmap_read(regmap, CS35L41_DSP_MBOX_2, &sts);
@@ -1478,19 +1499,27 @@
 
 		if (sts == CSPL_MBOX_STS_ERROR || sts == CSPL_MBOX_STS_ERROR2) {
 			dev_err(dev, "CSPL Error Detected\n");
-			return -EINVAL;
+			ret = -EINVAL;
+			goto out;
 		}
 
-		if (!cs35l41_check_cspl_mbox_sts(cmd, sts))
+		if (!cs35l41_check_cspl_mbox_sts(cmd, sts)) {
 			dev_dbg(dev, "[%u] cmd %u returned invalid sts %u", i, cmd, sts);
-		else
-			return 0;
+		} else {
+			ret = 0;
+			goto out;
+		}
 	}
 
 	if (cmd != CSPL_MBOX_CMD_OUT_OF_HIBERNATE)
 		dev_err(dev, "Failed to set mailbox cmd %u (status %u)\n", cmd, sts);
 
-	return -ENOMSG;
+out:
+	if (irq)
+		regmap_update_bits(regmap, CS35L41_IRQ2_MASK2,
+				   CS35L41_CSPL_MBOX_DSP_IRQ,
+				   CS35L41_CSPL_MBOX_DSP_IRQ);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(cs35l41_set_cspl_mbox_cmd);
 
