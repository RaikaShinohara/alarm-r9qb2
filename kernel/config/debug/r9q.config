# Built-in so the initramfs does not need modules to reach UFS / USB networking
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_I2C_QCOM_GENI=y
# Bootloader framebuffer
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# Logs that survive a warm reset (read back from TWRP: /sys/fs/pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# The APSS watchdog is armed by XBL and virtualised by the Haven/Gunyah
# hypervisor: MMIO access (qcom-wdt) causes an SError, the SMCCC driver works.
CONFIG_GUNYAH_WATCHDOG=y
# Uncompressed records: a flipped bit only damages a few characters
# CONFIG_PSTORE_COMPRESS is not set
# Mirror printk into Samsung sec_log_buf (TWRP: /proc/last_kmsg)
CONFIG_SAMSUNG_SEC_LOG_CONSOLE=y
# Samsung ABL only boots a plain gzip Image: an EFI zboot (PE/COFF) kernel
# makes it jump into garbage and the watchdog bites (no Linux output at all)
# CONFIG_EFI_ZBOOT is not set
# Readable console on a 1080x2340 6.4" panel (used with fbcon=font:TER16x32)
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Route MAX77705 MUIC to USB at boot: gadget enumerates without replugging
CONFIG_MAX77705_USB_SWITCH=y
# MAX77705 PMIC, charger and fuel gauge built in (battery works from early boot)
CONFIG_MFD_MAX77705=y
CONFIG_CHARGER_MAX77705=y
CONFIG_BATTERY_MAX17042=y
# Display: Samsung EA8082 AMB641ZR01 (patch 0005)
CONFIG_DRM_PANEL_SAMSUNG_EA8082=m
# Touchscreen: Synaptics S3908 TouchComm (patches 0006, 0007)
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C=m
# USB-C: MAX77705 CCIC (role switch, OTG VBUS, PD sink), patches 0010-0019
CONFIG_TYPEC_MAX77705=m
# Bluetooth LE features (ISO channels for LE Audio, ECRED): default y
# upstream, but off in config-stable.aarch64
CONFIG_BT_LE=y
# CPU L3 voting (epss_l3): built in, cpufreq-hw (built in) waits for it
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
# Landlock LSM (already first in CONFIG_LSM): pacman 7 on Arch downloads in a
# Landlock sandbox and refuses to sync without it
CONFIG_SECURITY_LANDLOCK=y
# PMIC RTC built in: as a module, the kernel set the clock back to the RTC
# (1970) when it loaded, after userspace had set it (Arch r9q-clock)
CONFIG_RTC_DRV_PM8XXX=y
