# Test builds only: APR audio, the SM8250 machine driver and the CS35L41
CONFIG_SOUND=y
# CONFIG_SND_SOC_QCOM_OFFLOAD_UTILS is not set
# CONFIG_SND_USB_AUDIO_QMI is not set
# amplifiers built in, since the test kernel cannot load the rootfs modules
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_COMMON=y
CONFIG_SND_SOC_QCOM_SDW=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_QDSP6_COMMON=y
CONFIG_SND_SOC_QDSP6_CORE=y
CONFIG_SND_SOC_QDSP6_AFE=y
CONFIG_SND_SOC_QDSP6_AFE_DAI=y
CONFIG_SND_SOC_QDSP6_AFE_CLOCKS=y
CONFIG_SND_SOC_QDSP6_ADM=y
CONFIG_SND_SOC_QDSP6_ROUTING=y
CONFIG_SND_SOC_QDSP6_ASM=y
CONFIG_SND_SOC_QDSP6_ASM_DAI=y
CONFIG_SND_SOC_SM8250=y
CONFIG_CS_DSP=y
CONFIG_SND_SOC_WM_ADSP=y
CONFIG_SND_SOC_CS35L41_LIB=y
CONFIG_SND_SOC_CS35L41=y
CONFIG_SND_SOC_CS35L41_I2C=y
# CONFIG_SND_SOC_QDSP6_USB is not set
# Microphones: LPASS LPI pinctrl (SM8350 lives in the SC7280 driver) and the
# VA macro that clocks the DMICs
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SC7280_LPASS_LPI=y
CONFIG_SND_SOC_LPASS_MACRO_COMMON=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
