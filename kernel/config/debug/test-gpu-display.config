# Test builds only (host-built kernel cannot load the pmbootstrap-signed
# modules because of lockdown): display + GPU stack built in, firmware in
# the vendor_boot ramdisk.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_PANEL_SAMSUNG_EA8082=y
CONFIG_SM_GPUCC_8350=y
CONFIG_QCOM_LLCC=y
# CONFIG_QCOM_OCMEM is not set
CONFIG_QCOM_MDT_LOADER=y
CONFIG_REGULATOR_QCOM_REFGEN=y
# The GPU asks for its firmware on first open, after switch_root, and the
# installed rootfs has none: build it into the test kernel.
CONFIG_EXTRA_FIRMWARE="qcom/a660_sqe.fw qcom/a660_gmu.bin qcom/sm8350/samsung/r9q/a660_zap.mbn"
CONFIG_EXTRA_FIRMWARE_DIR="./work/out-gpu/fwroot/usr/lib/firmware"
