# Test builds only: Bluetooth (QCA6490 on UART18) and the MAX77705 haptic
# built in, since the test kernel cannot load the rootfs modules
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_CRYPTO_ECDH=y
CONFIG_UHID=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_MAX77693_HAPTIC=y
CONFIG_PWM_CLK=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_HID_APPLE=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CHICONY=y
CONFIG_HID_MULTITOUCH=y
CONFIG_FUSE_FS=y
