# Test builds only: Type-C stack built in
CONFIG_TYPEC=y
CONFIG_TYPEC_MAX77705=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# DisplayPort alternate mode: combo PHY, SBU switch and the DRM bridges,
# built in because msm (built in for the test) binds the DP controller
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_TYPEC_MUX_GPIO_SBU=y
CONFIG_DRM_AUX_BRIDGE=y
CONFIG_DRM_AUX_HPD_BRIDGE=y
