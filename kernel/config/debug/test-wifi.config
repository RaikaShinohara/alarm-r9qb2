# Test builds only (host-built kernel cannot load the pmbootstrap-signed
# modules because of lockdown): Wi-Fi stack built in, firmware in initramfs.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_MHI_BUS=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
