# Test builds only: remoteproc (ADSP/CDSP/SLPI/modem over PAS) and the
# glink/QRTR plumbing built in; firmware comes from the vendor_boot ramdisk
# (the remoteprocs boot as soon as they probe, before the rootfs is mounted).
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_SOCINFO=y
