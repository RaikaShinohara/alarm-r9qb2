CONFIG_CMDLINE="console=tty0 loglevel=8 ignore_loglevel panic=1 clk_ignore_unused pd_ignore_unused rdinit=/init regulator_ignore_unused softlockup_panic=1 hardlockup_panic=1 hung_task_panic=1 watchdog_thresh=1 hung_task_timeout_secs=3 sysrq_always_enabled initcall_debug fbcon=font:TER16x32"
CONFIG_CMDLINE_FORCE=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=3
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
